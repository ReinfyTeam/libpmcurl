{
	"name": "reinfyteam/libpmcurl",
	"description": "Curl library for Axolotl-PM using curl_multi.",
	"version": "1.0.0",
	"type": "library",
	"license": "lgpl-3.0-or-later",
	"authors": [{
		"name": "ReinfyTeam",
		"email": "reinfy@gmail.com"
	}],
	"minimum-stability": "beta",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"reinfyteam\\libpmcurl\\": "src/ReinfyTeam/libpmcurl/"
		}
	},
	"repositories": [
		{
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
	],
	"require": {
		"php": "^8.4"
	},
	"require-dev": {
		"axolotl-pm/pocketmine-mp": "5.51.2",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"make-baseline": "@php ./vendor/bin/phpstan analyze -b phpstan-baseline.php -c phpstan.neon.dist --allow-empty-baseline",
		"fix-codestyle": "@php ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose --diff"
	},
	"extra": {
		"virion": {
			"spec": "3.0",
			"namespace-root": "reinfyteam\\libpmcurl"
		}
	}
}
